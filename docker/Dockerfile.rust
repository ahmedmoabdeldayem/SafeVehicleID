FROM rust:1.80-slim AS builder

WORKDIR /build

COPY rust/ ./

RUN cargo build --release 2>&1

# ─── Runtime image ────────────────────────────────────────────────────────────
FROM debian:bookworm-slim

COPY --from=builder /build/target/release/safe_vehicle_id /usr/local/bin/

ENTRYPOINT ["safe_vehicle_id"]
CMD ["--cameras", "1", "--frames", "0"]
